#!/usr/bin/env perl

# Prepares a commit message based on branch name.
# Handles change types, like fix/, chore/, etc. [converts to fix:, chore:]
# Handles issue numbers, like JIRA-123 [skips them].
#
# Usage: commit-msg COMMIT_MSG_FILE # <- prepares commit message
#        commit-msg lefthook        # <- creates lefthook-local.yml

use 5.010;
use strict;
use warnings;
use autodie;

use constant LEFTHOOK_CONFIG => <<'END';
templates:
  main_branch: master

prepare-commit-msg:
  jobs:
    - run: commit-msg "{1}" {main_branch}
      env:
        PATH: "$PATH:~/bin"
      only:
        - ref: '*/*'
      skip:
        - rebase
        - merge

END

if ($ARGV[0] eq "lefthook") {
  open(my $fh, '>', "lefthook-local.yml");
  print $fh LEFTHOOK_CONFIG;
  close($fh);
  exit(0);
}

my $commit_msg_file = $ARGV[0];
my $main_branch_name = $ARGV[1] || 'master';

# Read initial commit message
my $initial_content;
open(my $fh, '<', $commit_msg_file);
{
  local $/;
  $initial_content = <$fh>;
}
close $fh;

# Get branch name
my $branch = `git rev-parse --abbrev-ref HEAD 2>/dev/null`;
chomp($branch);

$branch =~ /(?:(\w+)\/)?([A-Z]+-\d+-)?(.+)/;
my ($type, $message) = ($1, $3);

$message =~ s/-/ /g;

# Uncomment if need capitalized message
# $message = ucfirst($message);

my $first_commit = `git rev-list --count HEAD ^${main_branch_name}`;
chomp($first_commit);

# Write
open($fh, '>', $commit_msg_file);
{
  if ($first_commit eq "0") {
    print $fh "$type: $message\n";
  }

  print $fh $initial_content;
}
close $fh;
